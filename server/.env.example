# Firebase Admin SDK
# FIREBASE_PROJECT_ID is your GCP project id
FIREBASE_PROJECT_ID=your-gcp-project-id

# Path to service account JSON (NEVER commit the actual json file)
# Download from: GCP Console → IAM → Service Accounts → your-sa → Keys → Add Key → JSON
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase_service.json

# Allowed Emails (comma-separated - fallback allowlist if Firestore role not set)
ALLOWED_EMAILS=operator1@yourcompany.com,operator2@yourcompany.com

# BigQuery Settings
# GCP Project ID (same as FIREBASE_PROJECT_ID usually)
GCP_PROJECT_ID=your-gcp-project-id

# BigQuery Dataset name (check your BigQuery console)
BQ_DATASET=Datas

# BigQuery Table names (exact case as shown in BigQuery console)
UCS_TABLE=UCS
SDR_TABLE=SDR
SMP_TABLE=SMP_3RX_SKID

# Server Settings
PORT=5000
NODE_ENV=development
